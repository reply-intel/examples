{
  "name": "Reply Intel \u2013 triage email replies",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ]
        },
        "options": {}
      },
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://reply-intel.pages.dev/v1/parse",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from.text, to: $json.to.text, subject: $json.subject, text: $json.text, html: $json.html || null, message_id: $json.messageId, in_reply_to: $json.inReplyTo || null, date: $json.date }) }}",
        "options": {
          "retry": {
            "maxTries": 3
          }
        }
      },
      "name": "Reply Intel: parse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "notes": "Create a Header Auth credential: name Authorization, value Bearer ri_live_..."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.requires_human_review }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Human review"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ ['positive_reply','interested','meeting_request','pricing_question'].includes($json.classification.primary_intent) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Hot lead"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ ['out_of_office','follow_up_required'].includes($json.classification.primary_intent) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Pause / follow up"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ ['negative_reply','unsubscribe','bounce'].includes($json.classification.primary_intent) }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Stop sequence"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "name": "Route by intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        300
      ]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Reply Intel: parse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reply Intel: parse": {
      "main": [
        [
          {
            "node": "Route by intent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "meta": {
    "note": "Not yet imported into a live n8n instance by the author; please open an issue if a field name differs on your version."
  }
}